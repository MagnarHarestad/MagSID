-		lda wt_start,x                         ; stores below
-		ldy flt_start,x
-		beq .nofilter                          ; instrument leaves the filter alone
-		sty filter_pos
-.nofilter:
-		ldy arp_start,x                        ; 0 for an instrument with no arpeggio
-		ldx ZP_ch
-		sta voice_wt_pos,x
-		tya
-		sta voice_arp_pos,x
-		if def v_vibrato
