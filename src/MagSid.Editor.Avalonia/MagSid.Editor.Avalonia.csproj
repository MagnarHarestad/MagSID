<Project Sdk="Microsoft.NET.Sdk">

  <!-- The cross-platform editor, in Avalonia. It starts as the SID player and grows view by view
       until it can stand in for the WinForms editor on every system. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MagSID</AssemblyName>
    <RootNamespace>MagSid.Editor.Avalonia</RootNamespace>
    <Version>1.73</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 1.64's icon, its frames kept as PNG - Avalonia misreads the old bitmap frames, and
         drew the black square see-through: on the .exe for Explorer and the taskbar, and
         embedded for the windows' title bars, which the .exe's icon does not reach. -->
    <ApplicationIcon>MagSID.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MagSid.Playback\MagSid.Playback.csproj" />
    <ProjectReference Include="..\MagSid.Audio.PortAudio\MagSid.Audio.PortAudio.csproj" />
    <ProjectReference Include="..\MagSid.Editor.Common\MagSid.Editor.Common.csproj" />
    <ProjectReference Include="..\MagSid.Editor.Views\MagSid.Editor.Views.csproj" />
    <ProjectReference Include="..\MagSid.Midi\MagSid.Midi.csproj" />
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <EmbeddedResource Include="MagSID.ico" LogicalName="MagSID.ico" />
  </ItemGroup>

</Project>
